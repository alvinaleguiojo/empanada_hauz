{
  "expo": {
    "name": "Empanada Hauz Rider",
    "slug": "empanada-hauz-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#241E19"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.empanadahauz.rider",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Empanada Hauz uses your location to update dispatch while you are delivering assigned orders.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Empanada Hauz shares your live location with dispatch while you are online or delivering, including when the app is in the background."
      }
    },
    "android": {
      "package": "com.empanadahauz.rider",
      "adaptiveIcon": {
        "backgroundColor": "#F45B25",
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "process.env.GOOGLE_MAPS_ANDROID_API_KEY"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Empanada Hauz shares your live location with dispatch while you are online or delivering, including when the app is in the background."
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "process.env.GOOGLE_MAPS_ANDROID_API_KEY"
        }
      ]
    ]
  }
}
