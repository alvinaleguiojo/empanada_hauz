{
  "expo": {
    "name": "Empanada Hauz Rider",
    "slug": "empanada-hauz-rider",
    "version": "1.0.0",
    "entryPoint": "./index.ts",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.empanadahauz.rider",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Empanada Hauz uses your location to update dispatch while you are delivering assigned orders.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Empanada Hauz shares your live location with dispatch while you are online or delivering, including when the app is in the background."
      }
    },
    "android": {
      "package": "com.empanadahauz.rider",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Empanada Hauz shares your live location with dispatch while you are online or delivering, including when the app is in the background."
        }
      ]
    ]
  }
}
