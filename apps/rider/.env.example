# Google Maps API key used by Expo Android builds
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Same Google Cloud project, but this one needs to be prefixed with
# EXPO_PUBLIC_ so it's actually available at runtime inside the app's JS
# (used for live road-following routes + ETA on the delivery map). Make
# sure "Directions API" is enabled for this key in Google Cloud Console -
# it's a separate toggle from "Maps SDK for Android".
EXPO_PUBLIC_GOOGLE_DIRECTIONS_API_KEY=YOUR_GOOGLE_DIRECTIONS_API_KEY
