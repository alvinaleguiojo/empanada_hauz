# Google Maps Android SDK key. Restrict it to com.empanadahauz.rider.
GOOGLE_MAPS_ANDROID_API_KEY=YOUR_ANDROID_MAPS_SDK_KEY

# Google Maps iOS SDK key. Restrict it to com.empanadahauz.rider.
GOOGLE_MAPS_IOS_API_KEY=YOUR_IOS_MAPS_SDK_KEY

# Optional fallback for both native platforms.
# GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Google Maps Routes API key used by RiderMapView for road routes, ETA, and turn instructions.
# Restrict this key to the Routes API in Google Cloud.
EXPO_PUBLIC_GOOGLE_ROUTES_API_KEY=YOUR_GOOGLE_ROUTES_API_KEY

# Backward-compatible fallback. Existing deployments can keep using this until migrated.
# EXPO_PUBLIC_GOOGLE_DIRECTIONS_API_KEY=YOUR_GOOGLE_DIRECTIONS_API_KEY
